{
  "appId": "com.arcleague.game",
  "productName": "ARC LEAGUE",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "dist"
  },
  "publish": {
    "provider": "github",
    "owner": "Xtqm",
    "repo": "arc-league"
  },
  "files": [
    "index.html",
    "desktop/**/*",
    "src/**/*",
    "assets/**/*",
    "assets/branding/**/*",
    "vendor/**/*",
    "package.json"
  ],
  "win": {
    "icon": "desktop/icon.ico",
    "target": [
      "portable",
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "${productName} Setup ${version}.${ext}"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Game"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "category": "public.app-category.action-games"
  }
}
